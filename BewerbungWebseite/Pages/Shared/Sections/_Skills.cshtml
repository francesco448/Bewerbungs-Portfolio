@model SectionView<SkillsSection>
@{
    var skills = Model.Section;
    var edit = Model.EditMode;
}

<section id="skills" class="portfolio-section" @EditMarkup.Section(edit, "skills")>
    <div class="container">
        <div class="dreamit-section-title style-two text-center section-title">
            <h5 @EditMarkup.Field(edit, "kicker", max: ContentLimits.Kicker)>@skills.Kicker</h5>
            <h1><partial name="_EditableText" model='new EditableText(skills.Title, "title", edit, ContentLimits.Heading)' /> <span @EditMarkup.Field(edit, "titleHighlight", max: ContentLimits.Heading)>@skills.TitleHighlight</span></h1>
            <p @EditMarkup.Field(edit, "intro", multiline: true, max: ContentLimits.ParagraphText)>@skills.Intro</p>
        </div>

        <div class="row skills-grid" @EditMarkup.List(edit, "items")>
            @for (var i = 0; i < skills.Items.Count; i++)
            {
                var item = skills.Items[i];
                @* Drei Kacheln pro Reihe; die mittlere Spalte hat im Theme eine eigene Variante. *@
                var boxClass = i % 3 == 1 ? "techno-sinlge-service-box-1" : "techno-sinlge-service-box";
                if (item.Highlighted)
                {
                    boxClass += " active";
                }

                <div class="col-lg-4 col-md-6 col-sm-12" @EditMarkup.Item(edit)>
                    <div class="@boxClass">
                        <div class="techno-service-box-inner">
                            <div class="techno-service-content">
                                <div class="techno-service-icon"><i class="@item.Icon"></i></div>
                                <div class="techno-service-title"><h2 @EditMarkup.Field(edit, "title", max: ContentLimits.TileTitle)>@item.Title</h2><p @EditMarkup.Field(edit, "text", multiline: true, max: ContentLimits.TileText)>@item.Text</p></div>
                            </div>
                        </div>
                    </div>
                    @if (edit)
                    {
                        <input class="pe-icon" type="text" data-field="icon" maxlength="@ContentLimits.IconClass" value="@item.Icon" aria-label="Icon-Klasse" />
                        <partial name="_EditItemControls" />
                        <label class="pe-flag"><input type="checkbox" data-flag="highlighted" checked="@(item.Highlighted ? "checked" : null)" /> hervorgehoben</label>
                    }
                </div>
            }
        </div>
        @if (edit)
        {
            <button type="button" class="pe-add" data-add="items">+ Kompetenz</button>
        }
    </div>
</section>
